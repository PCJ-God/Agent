# Copilot / local tooling
.deep-copilot/
.vscode/

# Environment files and local secrets
.env
.env.*
!.env.example

# Python cache, test, coverage, and build artifacts
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
dist/
build/
*.egg-info/

# Local logs and runtime output
*.log
logs/

# Local vector stores and databases
data/*.json
data/memory/
data/qdrant/
*.sqlite
*.sqlite3
*.db

# 用户自建技能的物化目录（运行期数据，源头在 SQLite 的 user_skills 表）
data/skills/

# TLS 证书与私钥：自签证书生成在 data/certs/，私钥绝不能进仓库
data/certs/
*.pem
*.key

# Frontend dependencies and build output
node_modules/
frontend/dist/
frontend/build/

skills/