# 环境配置模板
# 使用方法: cp .env.example .env && 编辑填入真实值

# ===== 必需 =====
# 阿里云 DashScope API Key（模型调用 + 远程 MCP 鉴权）
# 获取: https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===== Agent =====
LLM_MODEL=qwen-plus
MAX_REACT_ITERS=10

# ===== Memory =====
MAX_MEMORY_TOKENS=4096
ENABLE_LONG_TERM_MEMORY=true
QDRANT_PATH=./data/memory/qdrant
# 长期记忆作用域: session = 每个任务独立(互不干扰) / global = 跨任务累积
LTM_SCOPE=session

# ===== 公网部署（资源隔离）=====
# 线上必须用 Qdrant server: 本地文件版单进程独占, 多 worker 会抢锁失败
QDRANT_URL=
QDRANT_API_KEY=
# 每个用户最多能建多少任务
MAX_SESSIONS_PER_USER=50
# 进程内最多同时保留多少个任务实例(超出按 LRU 淘汰空闲的)
MAX_TEAMS=20
# 每个用户每分钟最多几次对话请求(<=0 关闭)
RATE_LIMIT_PER_MINUTE=20

# ===== 监听与 HTTPS =====
# 挂反向代理时保持 127.0.0.1(只本机可连, 由代理对外); 无代理才用 0.0.0.0
HOST=127.0.0.1
PORT=8000
# 直连 HTTPS 时填证书路径(见 scripts/gen_self_signed_cert.py);
# 挂反向代理则留空, 证书交给代理, 应用只跑 HTTP
SSL_CERTFILE=
SSL_KEYFILE=
# 信任哪个来源的 X-Forwarded-* 头; 代理在同机填 127.0.0.1, 绝不要填 *
FORWARDED_ALLOW_IPS=127.0.0.1

# ===== Embedding =====
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=2048

# ===== MCP（远程联网搜索）=====
MCP_SERVER_URL=https://dashscope.aliyuncs.com/api/v1/mcps/WebSearch/mcp
