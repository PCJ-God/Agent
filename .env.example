# 环境配置模板
# 用法：copy .env.example .env  然后填入真实值

# ===== 必需（唯一必填项）=====
# 阿里云百炼 DashScope API Key：模型调用 + 联网搜索 MCP 鉴权都靠它
# 获取地址：https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===== 模型 =====
LLM_MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v4
OCR_MODEL=qwen-vl-ocr
# 检索是否启用 gte-rerank 精排（true/false）
RERANK_ENABLED=true

# ===== Agent =====
# ReActAgent 单轮最大工具调用轮数
MAX_AGENT_ITERS=8

# ===== RAG / 长期记忆（Qdrant 集合名）=====
RAG_COLLECTION=acp_docs
MEMORY_COLLECTION=mem0
# 长期记忆向量维度（text-embedding-v4 = 2048，一般不用改）
MEMORY_EMBED_DIM=2048

# ===== 联网搜索（DashScope 远程 MCP）=====
MCP_SERVER_URL=https://dashscope.aliyuncs.com/api/v1/mcps/WebSearch/mcp

# ===== 网关 =====
# 生产环境务必改掉默认 JWT 密钥
JWT_SECRET=dev-secret-change-me
# 每用户每日对话/上传请求额度
RATE_LIMIT_PER_DAY=20
# 首次启动自动创建的管理员账号
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123456

# ===== 基础设施口令（生产建议改）=====
MYSQL_ROOT_PASSWORD=root
MYSQL_PASSWORD=acp123
RABBITMQ_PASSWORD=acp
MINIO_ROOT_USER=acpadmin
MINIO_ROOT_PASSWORD=acpadmin123
MINIO_BUCKET=acp-docs
GRAFANA_PASSWORD=admin
