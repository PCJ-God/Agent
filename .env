# 环境配置模板
# 使用方法: cp .env.example .env && 编辑填入真实值

# ===== 必需 =====
# 阿里云 DashScope API Key (通义千问模型调用)
# 获取: https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=sk-ws-H.ERPRPHR.hD5R.MEUCIBzcuCNRqiOrj_9pIpuRz3mEED3kA15OaSDMOYEpEUqhAiEAw0qa8XfAheEl62znQ_JpCCpAEQltN5x8FV__XhaUwUs

# ===== Agent =====
LLM_MODEL=qwen-plus
MAX_REACT_ITERS=10
TEMPERATURE=0.0

# ===== Memory =====
MEMORY_STRATEGY=InMemoryMemory
MAX_MEMORY_TOKENS=4096
ENABLE_LONG_TERM_MEMORY=false
QDRANT_PATH=./data/memory/qdrant

# ===== Embedding =====
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=2048

# ===== MCP =====
MCP_TRANSPORT=stdio
MCP_SERVER_URL=https://dashscope.aliyuncs.com/api/v1/mcps/WebSearch/mcp

# ===== 日志 =====
LOG_LEVEL=INFO
